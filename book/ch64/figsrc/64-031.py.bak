import sys, os, math; sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__)))); from figstyle import *
fig, ax = canvas(70)
C, R = (24, 42), 16
P = lambda k: (C[0] + R * math.cos(math.radians(90 - 72 * k)), C[1] + R * math.sin(math.radians(90 - 72 * k)))
def hop(a, b, role, cur):
    (x1, y1), (x2, y2) = P(a), P(b)
    d = math.hypot(x2 - x1, y2 - y1); ux, uy = (x2 - x1) / d, (y2 - y1) / d
    arrow(ax, (x1 + 3.6 * ux, y1 + 3.6 * uy), (x2 - 3.6 * ux, y2 - 3.6 * uy), role, curve=cur)
hop(0, 2, 'varie', 0.15); hop(2, 0, 'varie', 0.15)
hop(0, 3, 'autre', -0.35); hop(3, 0, 'autre', -0.35)
for k in range(5):
    disc(ax, P(k)[0], P(k)[1], 3, 'sujet', label=str(k), size='s')
text(ax, 24, 16, '2 + 3 = 0', 'varie', 's')
text(ax, 24, 9, '3 + 2 = 0', 'autre', 's')
box(ax, 56, 50, 30, 10, 'sujet', label=r'$G$ = ℤ/5 : 5', size='s')
arrow(ax, (60, 49.5), (60, 28.5), 'varie')
text(ax, 62, 43, 'un pas : G ⊃ {e}', 'varie', 's', ha='left')
text(ax, 62, 38, 'seul facteur : G, abélien', 'varie', 's', ha='left')
box(ax, 56, 18, 30, 10, 'resultat', label=r'$\{e\}$ : 1', size='s')
save(fig, '64-031')
